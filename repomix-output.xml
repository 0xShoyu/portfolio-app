        <button class="tabBtn" data-tab="code">
          💻 <span id="tabCodeLabel">Code</span>
        </button>
      </div>
      <main>
        <div id="codePane" class="pane tabHidden">
          <div id="keyRow">
            <label for="apiKeyInput">🔑</label>
            <input
              id="apiKeyInput"
              type="password"
              placeholder="Gemini API key (session only, never saved)"
              autocomplete="off"
            />
            <select id="modelSelect">
              <option value="gemini-3.6-flash">Gemini 3.6 Flash</option>
              <option value="gemini-3.5-flash">Gemini 3.5 Flash</option>
            </select>
          </div>
          <div id="keyHint">
            Only kept in memory for this tab — gone on refresh, never stored or
            sent anywhere but your own /api routes.
          </div>
          <div id="genRow">
            <input
              id="descInput"
              type="text"
              placeholder="Describe a model… e.g. a chibi astronaut with a jetpack"
            />
            <button id="genBtn">✨ Generate</button>
          </div>
          <div id="codeHint">
            Write a
            <code>function buildModel(THREE) { ... return group; }</code> —
            return a Mesh or Group. Camera, lighting, rotation and auto-fit are
            handled for you. (⌘/Ctrl+Enter to run)
          </div>
          <textarea id="codeEditor" spellcheck="false"></textarea>
        </div>
        <div id="previewPane" class="pane">
          <div id="canvasHolder"></div>
          <div id="topOverlay">
            <div id="stats">
              <span id="triLabel">Triangles</span>:
              <span id="triCount">0</span> |
              <span id="vertLabel">Vertices</span>:
              <span id="vertCount">0</span>
            </div>
            <div id="reviewBar">
              <button id="reviewBtn">🔍 Review</button>
              <button id="regenBtn">↻ Regenerate</button>
              <span id="verdictBadge"></span>
            </div>
          </div>
          <div id="errorBox"></div>
          <div id="critiqueBox"></div>
        </div>
      </main>
    </div>

    <script>
      function makeDefaultCode(comments) {
        return `function buildModel(THREE) {
  const HEIGHTS = { LEG: 0.4, TORSO: 0.5, HEAD: 0.3, JETPACK: 0.45 };
  const group = new THREE.Group();

  const suitMat = new THREE.MeshStandardMaterial({ color: 0xd8d8d8, roughness: 0.7 });
  const visorMat = new THREE.MeshStandardMaterial({ color: 0x1a2a33, roughness: 0.3, metalness: 0.4 });
  const jetpackMat = new THREE.MeshStandardMaterial({ color: 0x333844, roughness: 0.6 });
  const thrusterMat = new THREE.MeshStandardMaterial({ color: 0x00e5ff, emissive: 0x00e5ff, emissiveIntensity: 1.2 });

  ${comments.legs}
  const legs = new THREE.Mesh(new THREE.BoxGeometry(0.32, HEIGHTS.LEG, 0.22), suitMat);
  legs.position.y = HEIGHTS.LEG / 2;
  group.add(legs);

  ${comments.torso}
  const torso = new THREE.Mesh(new THREE.BoxGeometry(0.36, HEIGHTS.TORSO, 0.26), suitMat);
  torso.position.y = HEIGHTS.LEG + HEIGHTS.TORSO / 2;
  group.add(torso);

  ${comments.head}
  const head = new THREE.Mesh(new THREE.BoxGeometry(0.28, HEIGHTS.HEAD, 0.28), suitMat);
  head.position.y = HEIGHTS.LEG + HEIGHTS.TORSO + HEIGHTS.HEAD / 2;
  group.add(head);

  ${comments.visor}
  const visor = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.14, 0.03), visorMat);
  visor.position.set(0, HEIGHTS.LEG + HEIGHTS.TORSO + HEIGHTS.HEAD / 2, 0.14);
  group.add(visor);

  ${comments.jetpack}
  const jetpack = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.11, HEIGHTS.JETPACK, 8), jetpackMat);
  jetpack.position.set(0, HEIGHTS.LEG + HEIGHTS.TORSO / 2 + 0.05, -0.19);
  group.add(jetpack);

  ${comments.nozzle}
  const nozzle = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 0.08, 8), thrusterMat);
  nozzle.position.set(0, HEIGHTS.LEG, -0.19);
  group.add(nozzle);

  return group;
}`;
      }

      const DEFAULT_CODE = {
        en: makeDefaultCode({
          legs: "// legs",
          torso: "// torso",
          head: "// head",
          visor: "// helmet visor",
          jetpack: "// jetpack body",
          nozzle: "// nozzle (cyan glow = active state)",
        }),
        zh: makeDefaultCode({
          legs: "// 腿",
          torso: "// 躯干",
          head: "// 头",
          visor: "// 头盔面罩",
          jetpack: "// 背后喷射器主体",
          nozzle: "// 喷嘴（青色发光，对应 active 状态）",
        }),
        ja: makeDefaultCode({
          legs: "// 脚",
          torso: "// 胴体",
          head: "// 頭",
          visor: "// ヘルメットバイザー",
          jetpack: "// ジェットパック本体",
          nozzle: "// ノズル（シアン発光 = active 状態）",
        }),
      };

      const TRANSLATIONS = {
        en: {
          title: "🚀 Three.js Model Previewer",
          wireframe: "Wireframe",
          run: "▶ Run",
          clear: "Clear",
          tabPreview: "Preview",
          tabCode: "Code",
          hint: "Write a <code>function buildModel(THREE) { ... return group; }</code> — return a Mesh or Group. Camera, lighting, rotation and auto-fit are handled for you. (⌘/Ctrl+Enter to run)",
          triangles: "Triangles",
          vertices: "Vertices",
          errNotObject:
            "buildModel(THREE) must return a THREE.Object3D (a Mesh or Group)",
          errRender: "Render error: ",
          descPlaceholder:
            "Describe a model… e.g. a chibi astronaut with a jetpack",
          generate: "✨ Generate",
          review: "🔍 Review",
          regenerate: "↻ Regenerate",
          keyPlaceholder: "Gemini API key (session only, never saved)",
          keyHint:
            "Only kept in memory for this tab — gone on refresh, never stored or sent anywhere but your own /api routes.",
        },
        zh: {
          title: "🚀 Three.js 模型预览器",
          wireframe: "线框",
          run: "▶ 运行",
          clear: "清空",
          tabPreview: "预览",
          tabCode: "代码",
          hint: "写一个 <code>function buildModel(THREE) { ... return group; }</code>，返回一个 Mesh 或 Group 即可，摄像机/灯光/旋转由预览器自动处理。(⌘/Ctrl+Enter 运行)",
          triangles: "三角面",
          vertices: "顶点",
          errNotObject:
            "buildModel(THREE) 必须 return 一个 THREE.Object3D（Mesh 或 Group）",
          errRender: "渲染错误: ",
          descPlaceholder: '描述一个模型…比如"背着喷射背包的圆滚滚宇航员"',
          generate: "✨ 生成",
          review: "🔍 评审",
          regenerate: "↻ 重新生成",
          keyPlaceholder: "Gemini API key（只在本次会话有效，不会保存）",
          keyHint:
            "只存在这个标签页的内存里——刷新就没了，不会被保存，也只会发给你自己的 /api 接口。",
        },
        ja: {
          title: "🚀 Three.js モデルプレビューア",
          wireframe: "ワイヤーフレーム",
          run: "▶ 実行",
          clear: "クリア",
          tabPreview: "プレビュー",
          tabCode: "コード",
          hint: "<code>function buildModel(THREE) { ... return group; }</code> を書いてください。Mesh か Group を return するだけで、カメラ・ライト・回転・自動フィットは自動処理されます。(⌘/Ctrl+Enter で実行)",
          triangles: "三角形",
          vertices: "頂点",
          errNotObject:
            "buildModel(THREE) は THREE.Object3D（Mesh または Group）を return する必要があります",
          errRender: "レンダリングエラー: ",
          descPlaceholder:
            "モデルを説明…例：ジェットパックを背負ったちびキャラの宇宙飛行士",
          generate: "✨ 生成",
          review: "🔍 レビュー",
          regenerate: "↻ 再生成",
          keyPlaceholder:
            "Gemini APIキー（このセッションのみ、保存されません）",
          keyHint:
            "このタブのメモリ内にのみ保持されます。リロードすると消え、自分の /api ルート以外には送信されません。",
        },
      };

      let currentLang = "en";

      function isDefaultCode(value) {
        const trimmed = value.trim();
        return Object.values(DEFAULT_CODE).some((c) => c.trim() === trimmed);
      }

      function applyLanguage(lang) {
        currentLang = lang;
        const t = TRANSLATIONS[lang];
        document.documentElement.lang = lang === "zh" ? "zh-CN" : lang;
        document.getElementById("pageTitleTag").textContent = t.title.replace(
          "🚀 ",
          "",
        );
        document.getElementById("pageTitle").textContent = t.title;
        document.getElementById("wireframeLabel").textContent = t.wireframe;
        runBtn.textContent = t.run;
        clearBtn.textContent = t.clear;
        document.getElementById("codeHint").innerHTML = t.hint;
        document.getElementById("triLabel").textContent = t.triangles;
        document.getElementById("vertLabel").textContent = t.vertices;
        document.getElementById("tabPreviewLabel").textContent = t.tabPreview;
        document.getElementById("tabCodeLabel").textContent = t.tabCode;
        descInput.placeholder = t.descPlaceholder;
        genBtn.textContent = t.generate;
        reviewBtn.textContent = t.review;
        regenBtn.textContent = t.regenerate;
        apiKeyInput.placeholder = t.keyPlaceholder;
        document.getElementById("keyHint").textContent = t.keyHint;
        // Swap the starter code to match, only if the user hasn't edited it yet
        if (isDefaultCode(codeEditor.value)) {
          codeEditor.value = DEFAULT_CODE[lang];
        }
      }

      const codeEditor = document.getElementById("codeEditor");
      const runBtn = document.getElementById("runBtn");
      const clearBtn = document.getElementById("clearBtn");
      const errorBox = document.getElementById("errorBox");
      const triCountEl = document.getElementById("triCount");
      const vertCountEl = document.getElementById("vertCount");
      const wireframeToggle = document.getElementById("wireframeToggle");
      const canvasHolder = document.getElementById("canvasHolder");
      const langSelect = document.getElementById("langSelect");

      codeEditor.value = DEFAULT_CODE.en;
      langSelect.value = "en";
      langSelect.addEventListener("change", () =>
        applyLanguage(langSelect.value),
      );

      // ---------- 移动端 Code/Preview 标签页切换 ----------
      const tabBtns = document.querySelectorAll(".tabBtn");
      const codePaneEl = document.getElementById("codePane");
      const previewPaneEl = document.getElementById("previewPane");
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          tabBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          const tab = btn.dataset.tab;
          codePaneEl.classList.toggle("tabHidden", tab !== "code");
          previewPaneEl.classList.toggle("tabHidden", tab !== "preview");
          if (tab === "preview") {
            requestAnimationFrame(onResize);
          }
        });
      });

      // Tab 键插入空格 + Cmd/Ctrl+Enter 运行
      codeEditor.addEventListener("keydown", (e) => {
        if (e.key === "Tab") {
          e.preventDefault();
          const start = codeEditor.selectionStart,
            end = codeEditor.selectionEnd;
          codeEditor.value =
            codeEditor.value.slice(0, start) +
            "  " +
            codeEditor.value.slice(end);
          codeEditor.selectionStart = codeEditor.selectionEnd = start + 2;
        } else if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
          e.preventDefault();
          runUserCode();
        }
      });
      runBtn.addEventListener("click", runUserCode);
      clearBtn.addEventListener("click", () => {
        codeEditor.value = "";
        codeEditor.focus();
        clearModel();
        triCountEl.textContent = "0";
        vertCountEl.textContent = "0";
        clearError();
      });

      // ---------- AI 生成 + 视觉反馈自我修正 ----------
      const descInput = document.getElementById("descInput");
      const apiKeyInput = document.getElementById("apiKeyInput");
      const modelSelect = document.getElementById("modelSelect");
      const genBtn = document.getElementById("genBtn");
      const reviewBtn = document.getElementById("reviewBtn");
      const regenBtn = document.getElementById("regenBtn");
      const verdictBadge = document.getElementById("verdictBadge");
      const critiqueBox = document.getElementById("critiqueBox");

      let lastCritique = "";

      function resetReviewUI() {
        verdictBadge.textContent = "";
        verdictBadge.className = "";
        critiqueBox.style.display = "none";
        regenBtn.style.display = "none";
      }

      async function generateFromDescription(useFeedback) {
        const description = descInput.value.trim();
        if (!description) {
          showError("Enter a description first.");
          return;
        }
        genBtn.disabled = true;
        const originalLabel = genBtn.textContent;
        genBtn.textContent = "⏳ …";
        clearError();
        resetReviewUI();
        try {
          const body = useFeedback
            ? {
                description,
                previousCode: codeEditor.value,
                feedback: lastCritique,
                apiKey: apiKeyInput.value.trim() || undefined,
                model: modelSelect.value,
              }
            : {
                description,
                apiKey: apiKeyInput.value.trim() || undefined,
                model: modelSelect.value,
              };
          const res = await fetch("/api/generate-model", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          codeEditor.value = data.code;
          runUserCode();
        } catch (err) {
          showError("Generate failed: " + (err.message || String(err)));
        } finally {
          genBtn.disabled = false;
          genBtn.textContent = originalLabel;
        }
      }

      async function reviewCurrentRender() {
        const description = descInput.value.trim();
        if (!description) {
          showError(
            "Enter a description above first, so Review knows what to check against.",
          );
          return;
        }
        reviewBtn.disabled = true;
        const originalLabel = reviewBtn.textContent;
        reviewBtn.textContent = "⏳ …";
        try {
          renderer.render(scene, camera); // 确保画面是最新的
          const screenshot = renderer.domElement.toDataURL("image/png");
          const res = await fetch("/api/review-model", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              description,
              screenshot,
              apiKey: apiKeyInput.value.trim() || undefined,
              model: modelSelect.value,
            }),
          });
          const verdict = await res.json();
          if (verdict.error) throw new Error(verdict.error);

          const pct = Math.round((verdict.score || 0) * 100);
          verdictBadge.textContent = `${verdict.decision} (${pct}%)`;
          verdictBadge.className =
            verdict.decision === "continue" ? "pass" : "refine";

          if (verdict.decision === "refine" && verdict.critique) {
            lastCritique = verdict.critique;
            critiqueBox.textContent = "💬 " + verdict.critique;
            critiqueBox.style.display = "block";
            regenBtn.style.display = "inline-block";
          } else {
            critiqueBox.style.display = "none";
            regenBtn.style.display = "none";
          }
        } catch (err) {
          showError("Review failed: " + (err.message || String(err)));
        } finally {
          reviewBtn.disabled = false;
          reviewBtn.textContent = originalLabel;
        }
      }

      genBtn.addEventListener("click", () => generateFromDescription(false));
      descInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") generateFromDescription(false);
      });
      reviewBtn.addEventListener("click", reviewCurrentRender);
      regenBtn.addEventListener("click", () => generateFromDescription(true));

      // ---------- Three.js 场景搭建 ----------
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0b0f16);

      const camera = new THREE.PerspectiveCamera(45, 1, 0.01, 100);

      const renderer = new THREE.WebGLRenderer({
        antialias: true,
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      canvasHolder.appendChild(renderer.domElement);

      scene.add(new THREE.HemisphereLight(0x8fa3bf, 0x0e131b, 0.7));
      const keyLight = new THREE.DirectionalLight(0xffffff, 0.9);
      keyLight.position.set(3, 5, 4);
      scene.add(keyLight);
      const fillLight = new THREE.DirectionalLight(0x4488aa, 0.25);
      fillLight.position.set(-4, 1, -3);
      scene.add(fillLight);

      const grid = new THREE.GridHelper(4, 16, 0x2a3446, 0x1a2130);
      scene.add(grid);

      const modelGroup = new THREE.Group();
      scene.add(modelGroup);

      // ---------- 摄像机控制（拖拽转身 + 上下俯仰 + 滚轮/双指缩放）----------
      let elevation = 0.35;
      let camDistance = 3,
        minDist = 0.5,
        maxDist = 20;
      const lookTarget = new THREE.Vector3(0, 0.4, 0);

      function updateCamera() {
        const h = camDistance * Math.cos(elevation);
        const y = camDistance * Math.sin(elevation);
        camera.position.set(lookTarget.x, lookTarget.y + y, lookTarget.z + h);
        camera.lookAt(lookTarget);
      }

      const activePointers = new Map();
      let dragging = false,
        lastX = 0,
        lastY = 0;
      let pinchStartDist = null,
        pinchStartCamDist = null;

      function pointerDist() {
        const pts = Array.from(activePointers.values());
        return Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
      }
      function clamp(v, a, b) {
        return Math.max(a, Math.min(b, v));
      }

      canvasHolder.addEventListener("pointerdown", (e) => {
        canvasHolder.setPointerCapture(e.pointerId);
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (activePointers.size === 1) {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
        } else if (activePointers.size === 2) {
          dragging = false;
          pinchStartDist = pointerDist();
          pinchStartCamDist = camDistance;
        }
      });
      canvasHolder.addEventListener("pointermove", (e) => {
        if (!activePointers.has(e.pointerId)) return;
        activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (activePointers.size === 2) {
          const d = pointerDist();
          camDistance = clamp(
            pinchStartCamDist * (pinchStartDist / d),
            minDist,
            maxDist,
          );
          return;
        }
        if (dragging && activePointers.size === 1) {
          const dx = e.clientX - lastX,
            dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          modelGroup.rotation.y += dx * 0.008;
          elevation = clamp(elevation + dy * 0.008, -1.4, 1.4);
        }
      });
      function endPointer(e) {
        activePointers.delete(e.pointerId);
        if (activePointers.size === 0) dragging = false;
        else if (activePointers.size === 1) {
          dragging = true;
          const [p] = activePointers.values();
          lastX = p.x;
          lastY = p.y;
        }
      }
      canvasHolder.addEventListener("pointerup", endPointer);
      canvasHolder.addEventListener("pointercancel", endPointer);
      canvasHolder.addEventListener(
        "wheel",
        (e) => {
          e.preventDefault();
          camDistance = clamp(
            camDistance + e.deltaY * 0.0015 * camDistance,
            minDist,
            maxDist,
          );
        },
        { passive: false },
      );

      // ---------- 运行用户代码 ----------
      function clearModel() {
        while (modelGroup.children.length) {
          const obj = modelGroup.children.pop();
          obj.traverse((o) => {
            if (o.geometry) o.geometry.dispose();
            if (o.material) {
              (Array.isArray(o.material) ? o.material : [o.material]).forEach(
                (m) => m.dispose(),
              );
            }
          });
        }
      }

      function fitCameraToObject(object) {
        const box = new THREE.Box3().setFromObject(object);
        if (box.isEmpty()) {
          camDistance = 3;
          lookTarget.set(0, 0.4, 0);
          return;
        }
        const size = new THREE.Vector3();
        box.getSize(size);
        const center = new THREE.Vector3();
        box.getCenter(center);
        const maxDim = Math.max(size.x, size.y, size.z) || 1;
        const fitDist =
          (maxDim / (2 * Math.tan((camera.fov * Math.PI) / 180 / 2))) * 1.8;
        camDistance = fitDist;
        minDist = fitDist * 0.15;
        maxDist = fitDist * 8;
        lookTarget.copy(center);
      }

      function updateStats(object) {
        let tris = 0,
          verts = 0;
        object.traverse((o) => {
          if (o.isMesh && o.geometry) {
            const g = o.geometry;
            const posCount = g.attributes.position
              ? g.attributes.position.count
              : 0;
            verts += posCount;
            tris += g.index ? g.index.count / 3 : posCount / 3;
          }
        });
        triCountEl.textContent = Math.round(tris);
        vertCountEl.textContent = verts;
      }

      function applyWireframe() {
        modelGroup.traverse((o) => {
          if (o.isMesh && o.material) {
            (Array.isArray(o.material) ? o.material : [o.material]).forEach(
              (m) => {
                m.wireframe = wireframeToggle.checked;
              },
            );
          }
        });
      }
      wireframeToggle.addEventListener("change", applyWireframe);

      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.style.display = "block";
      }
      function clearError() {
        errorBox.style.display = "none";
        errorBox.textContent = "";
      }

      function runUserCode() {
        try {
          clearModel();
          const code = codeEditor.value;
          const fn = new Function(
            "THREE",
            code + "\n;return buildModel(THREE);",
          );
          const result = fn(THREE);
          if (!result || !(result instanceof THREE.Object3D)) {
            throw new Error(TRANSLATIONS[currentLang].errNotObject);
          }
          modelGroup.add(result);
          applyWireframe();
          fitCameraToObject(result);
          updateStats(result);
          clearError();
        } catch (err) {
          showError(err.message || String(err));
        }
      }

      // ---------- 尺寸自适应 ----------
      function onResize() {
        const w = canvasHolder.clientWidth,
          h = canvasHolder.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
      new ResizeObserver(onResize).observe(canvasHolder);

      // ---------- 渲染循环 ----------
      function animate() {
        requestAnimationFrame(animate);
        if (previewPaneEl.classList.contains("tabHidden")) return;
        updateCamera();
        try {
          renderer.render(scene, camera);
        } catch (err) {
          showError(
            TRANSLATIONS[currentLang].errRender + (err.message || String(err)),
          );
        }
      }

      onResize();
      runUserCode();
      animate();
    </script>
  </body>
</html>
</file>

